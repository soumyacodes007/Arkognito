# Copy to .env. Testnet only. Never commit .env, never put any of these on Arkiv.

# --- Network ---
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
ARKIV_WS_URL=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7738577
# Arkiv Hub key (https://hub.arkiv.network/api-keys) for higher rate limits. Server side only.
ARKIV_ACCESS_KEY=

# --- Running one relayer (npm run relayer) ---
RELAYER_PRIVATE_KEY=
RELAYER_PUBLIC_URL=http://localhost:8787
# REQUIRE_TOKENS=on
# ISSUER_WALLET_ADDRESS=
# ISSUER=on
# TOKENS_PER_DAY=5
# ISSUER_QUOTA_FILE=./issuer-quota.json

# --- Docker Compose (docker compose up -d) ---
# Public https URLs of your relayers once TLS is in front (see deploy/). Defaults: http://localhost:8787 / :8788
# RELAY_1_PUBLIC_URL=https://relay-1.example.com
# RELAY_2_PUBLIC_URL=https://relay-2.example.com
# OHTTP_ALLOW_LOCAL=on   # local development only

# --- Wallets for compose, the local network and tests (npm run setup fills these in) ---
RELAYER_1_PRIVATE_KEY=
RELAYER_1_ADDRESS=
RELAYER_2_PRIVATE_KEY=
RELAYER_2_ADDRESS=
ISSUER_WALLET_PRIVATE_KEY=
ISSUER_WALLET_ADDRESS=
# 32 random bytes as 0x-hex; the issuer's daily RSA keys derive from it.
ISSUER_RSA_SEED=
DEMO_USER_PRIVATE_KEY=
DEMO_USER_ADDRESS=

# Optional Semaphore membership (local group descriptors, never credentials).
# Each configured project requires its group proof in place of blind tokens.
# Persist the journal outside the public web root; share it across cooperating relayers on one host.
SEMAPHORE_GROUPS_FILE=
SEMAPHORE_JOURNAL=data/semaphore-admissions.jsonl
SEMAPHORE_HISTORY_BLOCKS=10000
SEMAPHORE_TRUSTED_RELAYERS=
