{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "customConditions": [
      "arkognito-source"
    ]
  },
  "include": [
    "apps/demo/src",
    "apps/demo/vite.config.ts",
    "packages/*/test",
    "packages/*/src",
    "packages/*/test",
    "tests",
    "spike",
    "scripts",
    "apps/demo/src"
  ]
}
